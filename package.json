{
  "name": "@thatmyassets/dashboard",
  "version": "0.1.4",
  "description": "Interactive installer for the ThatMyAssets dashboard",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "tma-dashboard": "bin/tma-dashboard.cjs"
  },
  "main": "installer/index.cjs",
  "files": [
    "bin/",
    "installer/",
    "cmd/",
    "internal/",
    "web/",
    "!web/tests/",
    "!web/.git/",
    "!web/node_modules/",
    "!web/.next/",
    "!web/*.tsbuildinfo",
    "compose.yaml",
    "Dockerfile",
    ".dockerignore",
    ".env.example",
    "go.mod",
    "go.sum",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build:release": "node scripts/build-release.cjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
