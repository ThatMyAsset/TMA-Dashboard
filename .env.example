# PostgreSQL
POSTGRES_DB=tma
POSTGRES_USER=tma
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Initial administrator. Existing passwords are never overwritten on restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Optional automation bearer token; minimum 32 characters. Leave blank to disable.
ADMIN_API_TOKEN=

# Dashboard published on host loopback by default for direct HTTP or an SSH tunnel.
DASHBOARD_HOST=127.0.0.1
WEB_PORT=3000

# Control Plane published on host loopback by default for Agent enrollment.
CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=18080
# Exact browser origin permitted for cookie-authenticated mutations.
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
TRUST_PROXY=false
# With an explicit external HTTPS proxy only: set both values above to true.
# Keep DASHBOARD_HOST on loopback; do not expose plain HTTP publicly.

# Direct local development (without Compose)
# DATABASE_URL=postgres://tma:password@127.0.0.1:5432/tma?sslmode=disable
# LISTEN_ADDR=:8080
# COOKIE_SECURE=false
# TRUST_PROXY=false
# CONTROL_PLANE_URL=http://127.0.0.1:8080
