# PostgreSQL
POSTGRES_DB=tma
POSTGRES_USER=tma
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Initial administrator. Existing passwords are never overwritten on restart.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-at-least-12-characters
# Optional automation bearer token; minimum 32 characters. Leave blank to disable.
ADMIN_API_TOKEN=
# Docker Control Plane connection string (installer generates the real value).
DATABASE_URL=postgres://tma:replace-with-database-password@postgres:5432/tma?sslmode=disable

# Lab HTTP deployment. Restrict VPS firewall/security group to your IP.
WEB_PORT=3000
CONTROL_PLANE_PORT=18080
# Exact browser origins permitted for cookie-authenticated mutations, comma-separated.
# Replace with your VPS IP for lab access: http://VPS_IP:3000
ALLOWED_ORIGINS=http://VPS_IP:3000
# Lab-only escape hatch. Set false in production and configure exact origins above.
# ALLOWED_ORIGINS=* is equivalent to DEV_ALLOW_ALL_ORIGINS=true.
DEV_ALLOW_ALL_ORIGINS=true
COOKIE_SECURE=false
TRUST_PROXY=false
# Production requires a separately managed trusted HTTPS proxy and firewall.

# Direct local development (without Compose)
# DATABASE_URL=postgres://tma:password@127.0.0.1:5432/tma?sslmode=disable
# LISTEN_ADDR=:8080
# COOKIE_SECURE=false
# TRUST_PROXY=false
# CONTROL_PLANE_URL=http://127.0.0.1:8080
